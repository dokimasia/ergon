
# Kotlin

# ktlint, which lint-kotlin downloads once into .gradle and checks against the checksum that
# Maven Central publishes for the release.
KTLINT_VERSION := 1.8.0
KTLINT_SHA256 := 369ad2b789f95a011f807e1fcb690ccef80bd7cd014fd139e73ae82dcc0baeab
KTLINT := .gradle/ergon/ktlint-cli-$(KTLINT_VERSION)-all.jar

.PHONY: fmt-kotlin lint-kotlin test-kotlin check-kotlin
fmt: fmt-kotlin
lint: lint-kotlin
test: test-kotlin
check: check-kotlin

$(KTLINT):
	@mkdir -p $(@D)
	curl --fail --silent --show-error --location --retry 3 --output $@.part \
		https://repo1.maven.org/maven2/com/pinterest/ktlint/ktlint-cli/$(KTLINT_VERSION)/ktlint-cli-$(KTLINT_VERSION)-all.jar
	@echo "$(KTLINT_SHA256)  $@.part" > $@.sha256
	@if command -v sha256sum > /dev/null; then sha256sum --check --strict $@.sha256; \
		else shasum --algorithm 256 --check $@.sha256; fi
	@mv $@.part $@

fmt-kotlin: $(KTLINT) ## Format the Kotlin sources with ktlint
	git ls-files -z --cached --others --exclude-standard -- '*.kt' '*.kts' | \
		java -jar $(KTLINT) --relative --format --patterns-from-stdin=
lint-kotlin: $(KTLINT) ## Check the Kotlin sources with ktlint, and the build's own checks
	git ls-files -z --cached --others --exclude-standard -- '*.kt' '*.kts' | \
		java -jar $(KTLINT) --relative --patterns-from-stdin=
	./gradlew check -x test
test-kotlin: ## Run the Kotlin tests
	./gradlew test
check-kotlin: lint-kotlin test-kotlin audit-jvm ## Run the gate of Kotlin
