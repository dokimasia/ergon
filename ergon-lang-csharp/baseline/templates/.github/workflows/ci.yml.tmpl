
  # The gate of C# on Linux, macOS and Windows, which runs once the repository has global.json.
  check-csharp:
    name: Check (C#, ${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: {{runners}}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - uses: {{checkout}}
        with:
          persist-credentials: false
      - if: hashFiles('global.json') != ''
        uses: ./.github/actions/setup-make
      - if: hashFiles('global.json') != ''
        uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68 # v6.0.0
        with:
          global-json-file: global.json
      - if: hashFiles('global.json') != ''
        shell: bash
        run: make check-csharp
