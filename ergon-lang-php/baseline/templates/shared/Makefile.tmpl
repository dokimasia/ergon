
# PHP
#
# The section php of .ergon.yaml sets the tools and the options of the PHP targets, and the steps
# of check-php. One run overrides an option on the command line, such as
# make test-php PHP_TEST_ARGS=--testdox.

# The tools of the PHP targets, which ergon installs at the versions of the section php into a
# Composer project of its own, apart from the composer.json of the repository.
PHPSTAN := $(ERGON) tool run php.phpstan --
PHP_CS_FIXER := $(ERGON) tool run php.php-cs-fixer --

# The options of the section php.
PHP_PATHS ?={{% with words .Options.Paths %}} {{% . %}}{{% end %}}
PHP_TEST_ARGS ?={{% with words .Options.Test.Args %}} {{% . %}}{{% end %}}

.PHONY: fmt-php lint-php test-php audit-php check-php
fmt: fmt-php
lint: lint-php
test: test-php
audit: audit-php
check: check-php

fmt-php: ## Format the PHP sources with the PER coding style
	$(PHP_CS_FIXER) fix --rules=@PER-CS --using-cache=no $(PHP_PATHS)
lint-php: ## Check the PHP sources with the PER coding style and PHPStan at its strictest level
	composer validate --strict
	composer install --no-interaction --no-progress
	$(PHP_CS_FIXER) check --rules=@PER-CS --using-cache=no --diff $(PHP_PATHS)
	$(PHPSTAN) analyse --configuration=phpstan.dist.neon --no-progress $(PHP_PATHS)
test-php: ## Run the PHP tests
	composer install --no-interaction --no-progress
	vendor/bin/phpunit $(PHP_TEST_ARGS)
audit-php: ## Scan composer.lock for known vulnerabilities and abandoned packages
	composer audit --locked
check-php:{{% range .Options.Check %}} {{% . %}}-php{{% end %}} ## Run the gate of PHP
