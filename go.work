go 1.27.2

// The repository root module (go.dokimi.dev/ergon) contains the binary and the composition root.
// Every other module is listed here, so builds and tests resolve across the modules without the
// network.
use (
	.
	./ergon-core
	./ergon-lang-bash
	./ergon-lang-csharp
	./ergon-lang-go
	./ergon-lang-java
	./ergon-lang-javascript
	./ergon-lang-kotlin
	./ergon-lang-php
	./ergon-lang-python
	./ergon-lang-rust
	./ergon-lang-terraform
	./ergon-lang-typescript
	./ergon-service
)

// The go command reads the go.mod of each version of a module of the workspace that another module
// requires. ergon release keeps a replace of each such version by the directory of its module, so
// the workspace builds before the tag of a version exists.
replace (
	go.dokimi.dev/ergon/core v0.8.0 => ./ergon-core
	go.dokimi.dev/ergon/lang/bash v0.3.6 => ./ergon-lang-bash
	go.dokimi.dev/ergon/lang/csharp v0.2.6 => ./ergon-lang-csharp
	go.dokimi.dev/ergon/lang/go v0.6.2 => ./ergon-lang-go
	go.dokimi.dev/ergon/lang/java v0.3.6 => ./ergon-lang-java
	go.dokimi.dev/ergon/lang/javascript v0.2.6 => ./ergon-lang-javascript
	go.dokimi.dev/ergon/lang/kotlin v0.3.6 => ./ergon-lang-kotlin
	go.dokimi.dev/ergon/lang/php v0.3.6 => ./ergon-lang-php
	go.dokimi.dev/ergon/lang/python v0.3.6 => ./ergon-lang-python
	go.dokimi.dev/ergon/lang/rust v0.3.6 => ./ergon-lang-rust
	go.dokimi.dev/ergon/lang/terraform v0.3.6 => ./ergon-lang-terraform
	go.dokimi.dev/ergon/lang/typescript v0.2.6 => ./ergon-lang-typescript
	go.dokimi.dev/ergon/service v0.9.0 => ./ergon-service
)
