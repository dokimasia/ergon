
  # The gate of Bash on Linux, macOS and Windows, with the shellcheck that the Makefile pins.
  check-bash:
    name: Check (Bash, ${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: {{runners}}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - uses: {{checkout}}
        with:
          persist-credentials: false
      - uses: ./.github/actions/setup-make
      - uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
      - shell: bash
        run: make check-bash
