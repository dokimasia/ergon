# Managed by ergon init, with .ergon/local/.gitignore merged in. Change the repository's settings there and run ergon init sync.

# Editors and IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Agents
.claude/
.codex/
.gemini/
AGENT.md
CLAUDE.md
GEMINI.md

# Operating systems
.DS_Store
Thumbs.db

# Secrets
.env
*.local
secrets.json

# ergon release
# The publish plan of the release workflow, which a build of a release must not see as a change
/publish-plan.json

# Go
bin/
coverage.out
*.test
# The artifacts of ergon release pack, which a build of a release must not see as changes
/dist/

# The build directory of the generator of the Cargo requirements of the Rust releases, which cargo
# and rust-analyzer write beside its Cargo.toml
/ergon-lang-rust/release/testdata/generate/target/
