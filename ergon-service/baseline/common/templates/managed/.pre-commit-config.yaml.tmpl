# Managed by ergon init. Add repository settings to .ergon/local/.pre-commit-config.yaml and run ergon init sync.
#
# Install the hooks with: pre-commit install

default_install_hook_types: [pre-commit, commit-msg, pre-push]
default_stages: [pre-commit]

repos:
  # File hygiene, without a language toolchain, at the release of the section common of
  # .ergon.yaml, before each commit. pre-commit-hooks declares three of these hooks for the stage
  # pre-push as well, so this configuration limits each of them to the stage pre-commit. The hooks
  # that change or refuse the content of a file skip the paths of common.hooks.exclude of
  # .ergon.yaml. trailing-whitespace also skips the Markdown files, in which two trailing spaces
  # break a line.
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: {{% yaml .Options.PreCommitHooks %}}
    hooks:
      - id: trailing-whitespace
        exclude_types: [markdown]
{{%- with .Options.Hooks.Exclude %}}
        exclude: {{% yaml . %}}
{{%- end %}}
        stages: [pre-commit]
      - id: end-of-file-fixer
{{%- with .Options.Hooks.Exclude %}}
        exclude: {{% yaml . %}}
{{%- end %}}
        stages: [pre-commit]
      - id: mixed-line-ending
        args: ["--fix=lf"]
{{%- with .Options.Hooks.Exclude %}}
        exclude: {{% yaml . %}}
{{%- end %}}
      - id: check-merge-conflict
      - id: detect-private-key
      - id: check-added-large-files
        args: ["--maxkb=500"]
{{%- with .Options.Hooks.Exclude %}}
        exclude: {{% yaml . %}}
{{%- end %}}
        stages: [pre-commit]
      - id: check-yaml
        args: ["--allow-multiple-documents"]
      - id: check-json
      - id: check-toml
      - id: check-symlinks

  - repo: local
    hooks:
{{%- with .Options.Hooks.PreCommit %}}
      # Each commit runs the targets of the Makefile that common.hooks.pre-commit of .ergon.yaml
      # lists.
{{%- range . %}}
      - id: {{% yaml . %}}
        name: make {{% . %}}
        entry: make {{% . %}}
        language: system
        pass_filenames: false
{{%- end %}}
{{% end %}}
{{%- with .Options.Hooks.PrePush %}}
      # Each push runs the targets of the Makefile that common.hooks.pre-push of .ergon.yaml lists.
{{%- range . %}}
      - id: {{% yaml . %}}
        name: make {{% . %}}
        entry: make {{% . %}}
        language: system
        pass_filenames: false
        stages: [pre-push]
{{%- end %}}
{{% end %}}
      # The commit message, against .commitlint.yaml. The command of the key ergon of the section
      # common of .ergon.yaml installs the commitlint of the section, and checks its archive against
      # the digest of the section.
      - id: commitlint
        name: commitlint
        entry: {{% yaml (printf "%s tool run common.commitlint -- lint --message" (words .Options.Ergon)) %}}
        language: system
        stages: [commit-msg]
