# Managed by ergon init. Add repository settings to .ergon/local/.github/workflows/codeql.yml and run ergon init sync.
#
# The CodeQL analysis of one language, which security.yml calls for each language that CodeQL
# analyzes. The analysis runs once the repository has the file that pins the toolchain of the
# language.

name: CodeQL

on:
  workflow_call:
    inputs:
      language:
        description: The CodeQL language to analyze, such as go or javascript-typescript.
        required: true
        type: string
      build-mode:
        description: How CodeQL extracts the language, none or autobuild.
        required: true
        type: string
      pin:
        description: The file that pins the toolchain of the language, such as go.work.
        required: true
        type: string

permissions: {}

jobs:
  analyze:
    name: Analyze
    runs-on: {{linux}}
    timeout-minutes: 30
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: {{checkout}}
        with:
          persist-credentials: false
      - if: hashFiles(inputs.pin) != ''
        uses: {{codeql-init}}
        with:
          languages: ${{ inputs.language }}
          build-mode: ${{ inputs.build-mode }}
      - if: hashFiles(inputs.pin) != ''
        uses: {{codeql-analyze}}
        with:
          category: /language:${{ inputs.language }}
