# Managed by ergon init. Add repository settings to .ergon/local/.github/workflows/ci.yml and run ergon init sync.
#
# The gate of the repository, with the jobs that each producer of ergon init contributes. A check
# of text runs on the Linux runner of the section github of .ergon.yaml, and every other job on a
# matrix of runners. A job that sets up a toolchain runs its steps once the repository has the
# files of the toolchain, and sets the toolchain up before ergon. A job that runs tools keeps the
# tools of ergon in the cache of GitHub Actions. version.yml opens the version pull request after
# the run of a push to main passes, and release.yml publishes a commit only when a run of the gate
# passed on its content. A new run of a pull request cancels its earlier run, and every other run
# has a concurrency group of its own.

name: CI

on:
  pull_request:
  merge_group:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.event_name == 'pull_request' && github.ref || github.run_id }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

# Every command runs in bash, which is Git Bash on Windows.
defaults:
  run:
    shell: bash

jobs:
{{%- range $i, $job := .Data.Jobs %}}
{{%- if $i %}}
{{% end %}}
  {{% .ID %}}:
    name: {{% yaml .Name %}}
{{%- if .If %}}
    if: {{% yaml .If %}}
{{%- end %}}
{{%- if .Runners %}}
    strategy:
      fail-fast: false
      matrix:
        os: {{% yaml .Runners %}}
{{%- if .Versions %}}
        version: {{% yaml .Versions %}}
{{%- end %}}
    runs-on: ${{ matrix.os }}
{{%- else %}}
    runs-on: {{% yaml $.Options.Linux %}}
{{%- end %}}
    timeout-minutes: {{% .Timeout %}}
{{%- if .Permissions %}}
    permissions:
{{%- range $scope, $access := .Permissions %}}
      {{% $scope %}}: {{% $access %}}
{{%- end %}}
{{%- else %}}
    permissions: {}
{{%- end %}}
{{%- if .Env %}}
    env:
{{%- range $name, $value := .Env %}}
      {{% $name %}}: {{% yaml $value %}}
{{%- end %}}
{{%- end %}}
    steps:
      - uses: {{% $.Options.CI.Actions.Checkout %}}
        with:
{{%- if .History %}}
          fetch-depth: 0
{{%- end %}}
          persist-credentials: false
{{%- if .Make %}}
      - {{% if .Guard %}}if: {{% yaml .Guard %}}
        {{% end %}}uses: ./.github/actions/setup-make
{{%- end %}}
{{%- steps .Setup %}}
{{%- if .Ergon %}}
      - {{% if .Guard %}}if: {{% yaml .Guard %}}
        {{% end %}}uses: ./.github/actions/setup-ergon
{{%- end %}}
{{%- steps .Steps %}}
{{%- end %}}
