{{% if .Options.CodeSecurity -%}}
# Managed by ergon init. Add repository settings to .ergon/local/.github/workflows/security.yml and run ergon init sync.
#
# The security checks: the review of the dependencies that a pull request changes, the weekly
# OpenSSF Scorecard of a public repository, and the CodeQL analysis of each language that a
# producer of ergon init contributes, which calls codeql.yml. ergon init renders this workflow only
# when the key code-security of the section github of .ergon.yaml is true, because a private
# repository needs GitHub Code Security for the analysis and the review. The steps that a producer
# contributes to the review run before it. A step appends the package URLs of the repository's own
# packages to ERGON_OWN_PACKAGES. The review leaves those packages out of its license check.

name: Security

on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "17 4 * * 1"

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  dependency-review:
    name: Dependency review
    if: github.event_name == 'pull_request'
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      contents: read
    steps:
      - uses: {{% .Options.CI.Actions.Checkout %}}
        with:
          persist-credentials: false
{{%- steps .Contributions.Review %}}
      - uses: {{% .Options.CI.Actions.DependencyReview %}}
{{%- if .Contributions.Review %}}
        with:
          allow-dependencies-licenses: ${{ env.ERGON_OWN_PACKAGES }}
{{%- end %}}

  # A scheduled run has no event payload with the visibility of the repository, so this job queries
  # the API of GitHub. The Scorecard runs only in a public repository.
  visibility:
    name: Visibility
    if: github.event_name == 'schedule'
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      contents: read
    outputs:
      private: ${{ steps.visibility.outputs.private }}
    steps:
      - name: Find whether the repository is private
        id: visibility
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          private="$(gh api "repos/$GITHUB_REPOSITORY" --jq .private)"
          echo "private=$private" >> "$GITHUB_OUTPUT"

  # Scorecard publishes its results only from a job whose steps are actions of its allow list, in a
  # workflow without defaults or environment variables at its top level.
  scorecard:
    name: Scorecard
    needs: visibility
    if: needs.visibility.outputs.private == 'false'
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      contents: read
      id-token: write
      security-events: write
    steps:
      - uses: {{% .Options.CI.Actions.Checkout %}}
        with:
          persist-credentials: false
      - uses: {{% .Options.CI.Actions.Scorecard %}}
        with:
          results_file: scorecard.sarif
          results_format: sarif
          publish_results: true
      - uses: {{% .Options.CI.Actions.CodeQL.Path "upload-sarif" %}}
        with:
          sarif_file: scorecard.sarif
{{%- range .Contributions.CodeQL %}}

  codeql-{{% .Language %}}:
    name: {{% yaml (printf "CodeQL (%s)" .Name) %}}
    uses: ./.github/workflows/codeql.yml
    permissions:
      actions: read
      contents: read
      security-events: write
    with:
      language: {{% yaml .Language %}}
      build-mode: {{% yaml .BuildMode %}}
      files: {{% yaml .Files %}}
      timeout: {{% .Timeout %}}
{{%- end %}}
{{% end -%}}
