# Managed by ergon init. Add repository settings to .ergon/local/.github/workflows/baseline.yml and run ergon init sync.
#
# A weekly upgrade of the managed files to the newest release of ergon. The job installs the ergon
# of the lock, whose ergon init ci upgrade starts the newest release. That release runs ergon init
# sync, and opens or updates the pull request of the change on the branch ergon-baseline/<base>.

name: Baseline

on:
  schedule:
    - cron: "23 5 * * 1"
  workflow_dispatch:

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

jobs:
  baseline:
    name: Upgrade to the newest ergon
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      contents: write
      pull-requests: write
    steps:
      - uses: {{% .Options.CI.Actions.Checkout %}}
        with:
          persist-credentials: false
      - uses: ./.github/actions/setup-ergon
      - name: Upgrade ergon
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          ergon init ci upgrade
