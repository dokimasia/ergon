# Managed by ergon init. Add repository settings to .ergon/local/.github/workflows/release.yml and run ergon init sync.
#
# The publish of the packages of the repository on every push to main. The job select-mode chooses
# the next job: publish for a commit with a package to publish, such as the merge of the version
# pull request that version.yml opens. The job verify lets the publish run only when a run of ci.yml
# passed on the content of the commit, such as the run of the version pull request. The jobs pack
# and publish then release each package of the publish plan. The job pack sets up the toolchains of
# the repository before ergon, which build the artifacts.

name: Release

on:
  push:
    branches: [main]

permissions: {}

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

# Every command runs in bash.
defaults:
  run:
    shell: bash

jobs:
  select-mode:
    name: Select the mode
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      contents: read
    outputs:
      mode: ${{ steps.mode.outputs.mode }}
    steps:
      - uses: {{% .Options.CI.Actions.Checkout %}}
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: ./.github/actions/setup-ergon
      - name: Select the mode
        id: mode
        run: |
          ergon release ci select-mode --output publish-plan.json
      - uses: {{% .Options.CI.Actions.UploadArtifact %}}
        with:
          name: publish-plan
          path: publish-plan.json
          if-no-files-found: error

  verify:
    name: Verify the gate
    needs: select-mode
    if: needs.select-mode.outputs.mode == 'publish'
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      actions: read
      contents: read
      pull-requests: read
    steps:
      - uses: {{% .Options.CI.Actions.Checkout %}}
        with:
          persist-credentials: false
      - uses: ./.github/actions/setup-ergon
      - name: Find a passed run of ci.yml
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          ergon release ci verify

  pack:
    name: Pack
    needs: [select-mode, verify]
    if: needs.select-mode.outputs.mode == 'publish'
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      contents: read
    steps:
      - uses: {{% .Options.CI.Actions.Checkout %}}
        with:
          fetch-depth: 0
          persist-credentials: false
{{%- steps .Contributions.Release %}}
      - uses: ./.github/actions/setup-ergon
      - uses: {{% .Options.CI.Actions.DownloadArtifact %}}
        with:
          name: publish-plan
      - name: Pack the packages
        run: |
          ergon release pack --from-publish-plan publish-plan.json --out-dir dist
      - uses: {{% .Options.CI.Actions.UploadArtifact %}}
        with:
          name: release
          path: |
            publish-plan.json
            dist
          if-no-files-found: error

  publish:
    name: Publish
    needs: pack
    runs-on: {{% yaml .Options.Linux %}}
    timeout-minutes: {{% .Options.CI.Timeout %}}
    permissions:
      contents: write
    outputs:
      published: ${{ steps.publish.outputs.published }}
      published-packages: ${{ steps.publish.outputs.published-packages }}
    steps:
      - uses: {{% .Options.CI.Actions.Checkout %}}
        with:
          fetch-depth: 0
          persist-credentials: false
      - uses: ./.github/actions/setup-ergon
      - uses: {{% .Options.CI.Actions.DownloadArtifact %}}
        with:
          name: release
      - name: Publish the packages
        id: publish
        env:
          GITHUB_TOKEN: ${{ github.token }}
        run: |
          ergon release publish --from-publish-plan publish-plan.json --from-pack-dir dist
