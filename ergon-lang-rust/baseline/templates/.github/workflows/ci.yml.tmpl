
  # The gate of Rust on Linux, macOS and Windows, which runs once the repository has
  # rust-toolchain.toml.
  check-rust:
    name: Check (Rust, ${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: {{runners}}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - uses: {{checkout}}
        with:
          persist-credentials: false
      - if: hashFiles('rust-toolchain.toml') != ''
        uses: ./.github/actions/setup-make
      - if: hashFiles('rust-toolchain.toml') != ''
        uses: actions-rust-lang/setup-rust-toolchain@ecabd13d1c56bd1345c230e542e9144811ad706f # v2.0.0
      - if: hashFiles('rust-toolchain.toml') != ''
        shell: bash
        run: make check-rust
