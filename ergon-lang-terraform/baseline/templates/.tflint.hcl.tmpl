# Managed by ergon init. Add repository settings to .ergon/local/.tflint.hcl and run ergon init sync.
#
# The configuration of tflint for every module of the repository: the release of tflint that the
# gate pins, and every rule of the terraform ruleset, which tflint bundles. A repository adds the
# ruleset of its provider, such as tflint-ruleset-aws, in its local file.

tflint {
  required_version = "0.64.0"
}

plugin "terraform" {
  enabled = true
  preset  = "all"
}
