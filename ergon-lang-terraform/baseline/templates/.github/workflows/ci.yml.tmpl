
  # The gate of Terraform on Linux, macOS and Windows, which runs once the repository has
  # .terraform-version. setup-tflint installs the tflint that .tflint.hcl requires, after it checks
  # the archive against the checksums of the release, and uv runs checkov, which scans the
  # configuration.
  check-terraform:
    name: Check (Terraform, ${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: {{runners}}
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    permissions:
      contents: read
    steps:
      - uses: {{checkout}}
        with:
          persist-credentials: false
      - if: hashFiles('.terraform-version') != ''
        uses: ./.github/actions/setup-make
      - if: hashFiles('.terraform-version') != ''
        id: pin
        shell: bash
        run: echo "version=$(cat .terraform-version)" >> "$GITHUB_OUTPUT"
      - if: hashFiles('.terraform-version') != ''
        uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          terraform_version: ${{ steps.pin.outputs.version }}
          terraform_wrapper: false
      - if: hashFiles('.terraform-version') != ''
        uses: terraform-linters/setup-tflint@6ffdbaa3be476b3431f7275c26966ef32ff60337 # v6.3.2
        with:
          tflint_version: v0.64.0
          checksums: |-
            cca9d13e2e1d7a2c627af60ff899a3c9b74212899416aeb96ec764d2ef954537
            2496e9cb3d24992d553b45e7c87a0fdc9449ca975233876247a9bfeda857e6c0
            fb42fb859d844b156a8ea9d3363078c4d8b85ca78782e60876b08c9b8e59f303
      - if: hashFiles('.terraform-version') != ''
        uses: astral-sh/setup-uv@c18668ad3cf93ea998bef934396af7bb5c839dc7 # v10.2.0
      - if: hashFiles('.terraform-version') != ''
        shell: bash
        run: make check-terraform
